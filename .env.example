# CognoDB / Neo4j Connection Environment Variables
# Obtain your free CognoDB instance at https://console.cognodb.com/signup
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_generated_password

# Set to "true" to force live database mode, or leave empty to allow graceful auto-fallback if unreachable
FORCE_LIVE_DB=false
